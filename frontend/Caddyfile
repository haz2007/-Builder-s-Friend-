# SITE_ADDRESS — домен (например builders-friend.ru): Caddy сам получит
# сертификат Let's Encrypt. Для проверки без домена — ":80".
# Несколько адресов через запятую: "builders-friend.ru, www.builders-friend.ru,
# builders-friend.duckdns.org" — тогда PRIMARY_HOST=builders-friend.ru, и все
# остальные адреса постоянно перенаправляются на него.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@secondary expression `"{$PRIMARY_HOST:}" != "" && {host} != "{$PRIMARY_HOST:}"`
	redir @secondary https://{$PRIMARY_HOST:}{uri} permanent

	# API и загруженные фото — на бэкенд
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	# Swagger (/docs, /openapi.json) наружу не отдаём: карта API — лишняя
	# подсказка атакующему. Спецификация лежит в docs/api/openapi.json
	# Карта сайта для Яндекс Вебмастера — её собирает бэкенд по товарам и разделам
	handle /sitemap.xml {
		rewrite * /api/v1/seo/sitemap.xml?host={hostport}&scheme={scheme}
		reverse_proxy backend:8000
	}

	# Сайт: файлы сборки, остальные адреса (/catalog/1, /admin) — index.html
	handle {
		root * /srv
		try_files {path} /index.html

		# В index.html — SEO-шапка страницы от бэкенда (httpInclude),
		# в robots.txt — адрес карты сайта
		@page path / /index.html /robots.txt
		templates @page {
			mime text/html text/plain
		}
		file_server

		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Браузер ходит на сайт только по HTTPS (по HTTP заголовок игнорируется)
		Strict-Transport-Security "max-age=31536000"
		# Встраивать сайт в чужие страницы нельзя (защита от кликджекинга);
		# исключение — Яндекс Метрика: Вебвизор показывает записи во фрейме
		Content-Security-Policy "frame-ancestors 'self' https://*.yandex.ru https://*.yandex.com https://*.yandex.by https://*.yandex.kz https://*.yandex.uz https://*.yandex.com.tr https://*.ya.ru https://metrika.yandex https://metrica.yandex https://*.webvisor.com"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		-Server
	}
}
