# Скопируй в .env.production на сервере и заполни. Сам файл в git не попадает.

# Домен сайта: Caddy сам выпустит HTTPS-сертификат (домен должен смотреть на IP сервера).
# Без домена — ":80", сайт откроется по IP без HTTPS.
SITE_ADDRESS=builders-friend.ru

# База данных
POSTGRES_USER=wood
POSTGRES_DB=wood_commerce
# Длинный случайный пароль: openssl rand -base64 24
POSTGRES_PASSWORD=

# Ключ подписи токенов входа: openssl rand -hex 32
SECRET_KEY=

# Telegram-бот (запускается с --profile bot)
TELEGRAM_BOT_TOKEN=
# Если сервер не достаёт до api.telegram.org: socks5://user:pass@host:port
TELEGRAM_PROXY=

# Процессов API: 1 для сервера с 1 ГБ памяти, 2 — для 2 ГБ и больше
WEB_CONCURRENCY=1
