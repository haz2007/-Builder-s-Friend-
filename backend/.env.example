# Скопируй в backend/.env и заполни своими значениями
DATABASE_URL=postgresql://postgres:postgres@localhost:5110/wood_commerce

# Секрет для подписи токенов входа (любая длинная случайная строка)
SECRET_KEY=change-me
# Сколько минут живёт вход (по умолчанию 7 дней)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Telegram: токен бота от @BotFather.
# Уведомления получают те, кто вошёл в бота: покупатель — о своих заказах,
# администраторы — обо всех.
TELEGRAM_BOT_TOKEN=
